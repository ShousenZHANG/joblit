// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  NEW
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  ACCEPTED
}

enum ApplicationEventType {
  STATUS_CHANGED
  NOTE_ADDED
  INTERVIEW_PLANNED
  INTERVIEW_COMPLETED
  OFFER_RECORDED
  OFFER_UPDATED
  OFFER_DECIDED
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
}

enum ApplicationEventSource {
  USER
  EXTENSION
  SYSTEM
  IMPORT
}

enum EvidenceKind {
  RESUME_PROFILE
  JOB_DESCRIPTION
  APPLICATION_DRAFT
  USER_CLAIM
  STAR_STORY
  INTERVIEW_NOTE
  OFFER
}

enum JobLivenessStatus {
  ACTIVE
  EXPIRED
  UNCERTAIN
}

enum SourceHealthStatus {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum FetchRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

enum OnboardingStage {
  NEW_USER
  ACTIVATED_USER
  RETURNING_USER
}

enum ApplicationBatchScope {
  NEW
}

enum ApplicationBatchStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ApplicationBatchTaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum ApplicationStatus {
  DRAFT
  FINAL
}

enum ApplicationArtifactTarget {
  RESUME_PDF
  COVER_PDF
  RESUME_TEX
  COVER_TEX
}

enum ApplicationArtifactState {
  STAGED
  REFERENCED
  DELETE_PENDING
  DELETING
  DELETED
}

enum TailoringRunSource {
  MANUAL_IMPORT
  LOCAL_AI
  CODEX_BATCH
  SERVER_BATCH
}

enum TailoringRunDelivery {
  DRAFT
  FINAL
}

enum TailoringRunStatus {
  ISSUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIAL
}

enum TailoringRunTarget {
  RESUME
  COVER
}

enum FitBatchClaimStatus {
  ACTIVE
  SETTLED
  FAILED
  CANCELLED
  SUPERSEDED
}

enum FitBatchClaimItemOutcome {
  SCORED
  FAILED
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  jobs                   Job[]
  fetchRuns              FetchRun[]
  deletedJobUrls         DeletedJobUrl[]
  dailyCheckins          DailyCheckin[]
  resumeProfiles         ResumeProfile[]
  activeResumeProfiles   ActiveResumeProfile[]
  applications           Application[]
  promptRuleTemplates    PromptRuleTemplate[]
  onboardingState        OnboardingState?
  applicationBatches     ApplicationBatch[]
  applicationBatchTasks  ApplicationBatchTask[]
  tailoringRuns          TailoringRun[]
  agentCredentials       AgentCredential[]
  fitBatchClaims         FitBatchClaim[]
  fitBatchImportReceipts FitBatchImportReceipt[]
  applicationEvents      ApplicationEvent[]
  evidenceSnapshots      EvidenceSnapshot[]
  claimEvidence          ClaimEvidence[]
}

model Account {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Job {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobUrl          String
  title           String
  company         String?
  location        String?
  jobType         String?
  jobLevel        String?
  description     String?
  salary          String? // e.g. "$120,000 – $150,000 per year" (source-provided label)
  workArrangement String? // "Remote" | "Hybrid" | "On-site"
  listingDate     DateTime? // when the source posted the role
  status          JobStatus @default(NEW)
  market          String    @default("AU") // "AU" | "CN" | "GLOBAL"
  /// Ingestion provenance: "linkedin" | "nowcoder" | a source-registry id.
  /// Null for rows imported before provenance tracking existed.
  source          String?

  // AI role-fit triage. The matrix is model-produced per-requirement judgements;
  // the score/verdict are ALWAYS aggregated deterministically by Joblit.
  fitScore        Int?
  fitVerdict      String? // "STRONG" | "GOOD" | "MODERATE" | "WEAK" | "POOR"
  fitEligibility  String? // "PASS" | "RISK" | "BLOCK"
  fitMatrix       Json? // requirement matrix; null when only prescreened
  fitSource       String? // "prescreen" | "batch" | transient "claim:<uuid>"
  fitScoredAt     DateTime?
  fitSnapshotHash String? // resume snapshot hash the score was computed against

  // Posting legitimacy — the third axis beside role fit and eligibility.
  // Deterministic, computed at import, zero LLM. Higher is riskier. Flags are
  // advisory only: a risky posting is surfaced, never dropped.
  postingRisk      Int?
  postingRiskFlags Json?

  /// Soft "same opening" key for spotting a posting that reappears under a new
  /// URL. Deliberately NOT unique: distinct openings can collide, so this only
  /// ever powers a "possible duplicate" hint, never an automatic removal.
  companyRoleKey String?

  /// Deterministic 64-bit SimHash (16 lowercase hex chars) for advisory-only
  /// near-duplicate detection. Never used as a unique key.
  descriptionSimHash String?           @db.Char(16)
  livenessStatus     JobLivenessStatus @default(UNCERTAIN)
  livenessReason     String?
  livenessCheckedAt  DateTime?
  lastSeenAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications          Application[]
  applicationBatchTasks ApplicationBatchTask[]
  tailoringRuns         TailoringRun[]
  applicationEvents     ApplicationEvent[]
  evidenceSnapshots     EvidenceSnapshot[]

  @@unique([userId, jobUrl])
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([userId, market, createdAt])
  @@index([userId, jobLevel], map: "idx_job_user_joblevel")
  @@index([userId, fitScore])
  @@index([userId, postingRisk])
  @@index([userId, companyRoleKey])
  @@index([userId, descriptionSimHash])
  @@index([userId, livenessStatus])
  @@index([userId, source])
  @@index([title(ops: raw("gin_trgm_ops"))], map: "idx_job_title_trgm", type: Gin)
  @@index([company(ops: raw("gin_trgm_ops"))], map: "idx_job_company_trgm", type: Gin)
  @@index([location(ops: raw("gin_trgm_ops"))], map: "idx_job_location_trgm", type: Gin)
}

/// Durable proof that one exact Fit result crossed the Job update commit seam.
/// A matching retry returns the same validated settlement semantics.
model FitBatchImportReceipt {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  issueKey           String         @db.Char(64)
  requestHash        String         @db.Char(64)
  settlement         Json
  protocolVersion    Int            @default(1)
  claimId            String?        @unique @db.Uuid
  claim              FitBatchClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)
  executionAttemptId String?        @db.Uuid
  createdAt          DateTime       @default(now())

  @@unique([userId, issueKey])
  @@index([userId, createdAt])
}

/// Durable, content-addressed ownership of one exact ordered Fit job set.
/// Prompt text and model output remain outside PostgreSQL; receipt hashes are
/// enough to fence settlement and replay without retaining those payloads.
/// Raw SQL enforces at most one ACTIVE Claim per user; Prisma cannot express
/// that partial unique index, so every writer must still handle P2002 safely.
model FitBatchClaim {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          FitBatchClaimStatus @default(ACTIVE)
  protocolVersion Int                 @default(2)

  /// Bound once `/fit/prompt` issues the immutable prompt receipt.
  issueKey           String? @db.Char(64)
  issueHash          String? @db.Char(64)
  promptHash         String? @db.Char(64)
  promptMetaHash     String? @db.Char(64)
  promptMeta         Json?
  resumeProfileId    String? @db.Uuid
  resumeSnapshotHash String? @db.Char(64)
  jobSetHash         String? @db.Char(64)

  executionAttemptId      String    @db.Uuid
  executionLeaseExpiresAt DateTime?
  lastHeartbeatAt         DateTime?
  attempt                 Int       @default(1)

  errorCode    String?
  errorMessage String?
  issuedAt     DateTime  @default(now())
  settledAt    DateTime?
  terminalAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items   FitBatchClaimItem[]
  receipt FitBatchImportReceipt?

  @@index([userId, status, executionLeaseExpiresAt], map: "FitBatchClaim_userId_status_lease_idx")
  @@index([userId, issueKey, updatedAt])
  @@index([executionAttemptId])
}

/// Immutable ordered membership. `jobId` is intentionally an identity
/// snapshot rather than a foreign key so settlement can record a deterministic
/// failed outcome when a Job is deleted while an Agent is working.
model FitBatchClaimItem {
  claimId String        @db.Uuid
  claim   FitBatchClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  ordinal Int
  jobId   String        @db.Uuid

  outcome     FitBatchClaimItemOutcome?
  failureCode String?
  releasedAt  DateTime?

  @@id([claimId, jobId])
  @@unique([claimId, ordinal])
  @@index([jobId])
}

/// Raw SQL enforces at most one QUEUED/RUNNING batch per user. The partial
/// unique index is intentionally absent from Prisma's declarative index list.
model ApplicationBatch {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope       ApplicationBatchScope  @default(NEW)
  status      ApplicationBatchStatus @default(QUEUED)
  totalCount  Int
  error       String?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks ApplicationBatchTask[]

  @@index([userId, createdAt])
  @@index([userId, status, updatedAt])
}

model ApplicationBatchTask {
  id      String           @id @default(uuid()) @db.Uuid
  batchId String           @db.Uuid
  batch   ApplicationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId  String           @db.Uuid
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId   String           @db.Uuid
  job     Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status      ApplicationBatchTaskStatus @default(PENDING)
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  attempt     Int                        @default(0)

  executionAttemptId       String?   @db.Uuid
  executionLeaseExpiresAt  DateTime?
  /// 0 = legacy task semantics; a v1 claim upgrades this atomically before work.
  tailoringProtocolVersion Int       @default(0)
  /// Durable proof that the current attempt completed through TailoringRun acceptance.
  completionAttemptId      String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tailoringRun TailoringRun?

  @@unique([batchId, jobId])
  @@index([jobId, batchId])
  @@index([batchId, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([executionAttemptId])
  @@index([completionAttemptId])
}

model TailoringRun {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String @db.Uuid
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  resumeProfileId String?        @db.Uuid
  resumeProfile   ResumeProfile? @relation(fields: [resumeProfileId], references: [id], onDelete: SetNull)

  applicationBatchTaskId String?               @unique @db.Uuid
  applicationBatchTask   ApplicationBatchTask? @relation(fields: [applicationBatchTaskId], references: [id], onDelete: SetNull)

  applicationId String?      @db.Uuid
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  source   TailoringRunSource
  delivery TailoringRunDelivery
  status   TailoringRunStatus   @default(ISSUED)

  requiredTargetMask Int
  acceptedTargetMask Int @default(0)

  issueKey       String
  issueHash      String
  promptReceipts Json

  resumeSnapshotHash String
  jobSnapshotHash    String

  executionAttemptId      String?   @db.Uuid
  executionLeaseExpiresAt DateTime?
  attempt                 Int       @default(0)

  errorCode    String?
  errorMessage String?

  issuedAt   DateTime  @default(now())
  startedAt  DateTime?
  terminalAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  receipts TailoringRunReceipt[]

  @@unique([userId, issueKey])
  @@index([userId, status, updatedAt])
  @@index([jobId, status, createdAt])
  @@index([resumeProfileId])
  @@index([applicationId, createdAt])
  @@index([executionAttemptId])
}

model TailoringRunReceipt {
  id    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId String       @db.Uuid
  run   TailoringRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  target             TailoringRunTarget
  executionAttemptId String             @db.Uuid
  requestHash        String

  applicationId       String?              @db.Uuid
  application         Application?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  aiContentHash       String
  /// Target-scoped content identity accepted by this receipt. Null only for
  /// receipts created before document-level publication tracking.
  documentContentHash String?
  delivery            TailoringRunDelivery
  createdAt           DateTime             @default(now())

  @@unique([runId, target])
  @@index([applicationId, createdAt])
  @@index([executionAttemptId])
}

model DeletedJobUrl {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobUrl    String
  deletedAt DateTime @default(now())

  @@unique([userId, jobUrl])
  @@index([userId, deletedAt])
}

model DailyCheckin {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  localDate String
  checkedAt DateTime @default(now())

  @@unique([userId, localDate])
  @@index([userId, localDate])
}

model FetchRun {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nullable compatibility snapshot for pre-v1 rows. Execution and commits
  // never read or expose it; ownership is derived exclusively from userId.
  userEmail String?
  market    String  @default("AU") // "AU" | "CN" | "GLOBAL"

  status          FetchRunStatus @default(QUEUED)
  error           String?
  importedCount   Int            @default(0)
  discoveredCount Int            @default(0)
  invalidCount    Int            @default(0)

  // Execution/commit protocol projection. Batch receipts are the durable
  // idempotency source of truth; these fields make the current projection
  // cheap to read and enforce one ordered batch stream per run.
  commitStartedAt         DateTime?
  terminalAt              DateTime?
  expectedBatchCount      Int?
  nextBatchIndex          Int       @default(0)
  executionAttemptId      String?   @db.Uuid
  executionLeaseExpiresAt DateTime?

  // Fetch parameters (JSON so we can evolve without migrations)
  queries            Json
  location           String?
  hoursOld           Int?
  resultsWanted      Int?
  includeFromQueries Boolean @default(false)
  filterDescription  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commitReceipts FetchRunCommitReceipt[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model FetchRunCommitReceipt {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fetchRunId String   @db.Uuid
  fetchRun   FetchRun @relation(fields: [fetchRunId], references: [id], onDelete: Cascade)

  batchKey           String
  executionAttemptId String   @db.Uuid
  batchIndex         Int
  batchCount         Int
  requestHash        String
  itemCount          Int
  importedCount      Int
  invalidCount       Int
  terminal           Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@unique([fetchRunId, batchKey])
  @@unique([fetchRunId, batchIndex])
  @@index([fetchRunId, createdAt])
}

model ResumeProfile {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String @default("Custom Blank")
  revision Int    @default(1)
  locale   String @default("en-AU") // "en-AU" | "zh-CN"

  summary     String?
  basics      Json?
  links       Json?
  skills      Json?
  experiences Json?
  projects    Json?
  education   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications     Application[]
  activeSelections ActiveResumeProfile[]
  tailoringRuns    TailoringRun[]

  @@index([userId, name])
  @@index([userId, updatedAt])
  @@index([userId, locale, updatedAt])
}

model ActiveResumeProfile {
  userId          String        @db.Uuid
  locale          String        @default("en-AU") // "en-AU" | "zh-CN"
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeProfileId String        @db.Uuid
  resumeProfile   ResumeProfile @relation(fields: [resumeProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@id([userId, locale])
  @@index([resumeProfileId])
}

model Application {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String? @db.Uuid
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  resumeProfileId String?        @db.Uuid
  resumeProfile   ResumeProfile? @relation(fields: [resumeProfileId], references: [id], onDelete: SetNull)

  company String?
  role    String?
  /// Historical document locale retained for schema/data compatibility.
  locale  String  @default("en-AU")

  resumeTexUrl  String?
  resumePdfUrl  String?
  resumePdfName String?
  coverTexUrl   String?
  coverPdfUrl   String?

  // Tailor edit workflow (see ADR-0002 / ADR-0011).
  // status:        compatibility projection; FINAL only when every present
  //                Resume/Cover document is independently current.
  // aiContent:     persisted AI proposals + user accept/reject/edit decisions.
  // aiContentHash: stable whole-row hash for stale-write detection across tabs.
  // Existing rows are backfilled to FINAL with NULL aiContent — opening
  // them in the editor prompts re-generation since AI provenance is lost.
  status              ApplicationStatus @default(FINAL)
  aiContent           Json?
  aiContentHash       String?
  /// Current target-scoped render-effective content and input identities.
  resumeContentHash   String?
  coverContentHash    String?
  /// Content identities represented by the current target PDF pointers.
  resumePublishedHash String?
  coverPublishedHash  String?
  /// Last deterministic ATS/PDF machine-readability validation result.
  atsValidation       Json?
  /// Last structured reviewer report, including evidence coverage.
  reviewReport        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationEvents ApplicationEvent[]
  evidenceSnapshots EvidenceSnapshot[]
  claimEvidence     ClaimEvidence[]
  tailoringRuns     TailoringRun[]
  tailoringReceipts TailoringRunReceipt[]

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

/// Durable Blob lifecycle ledger. Snapshot identifiers intentionally have no
/// foreign keys so retirement evidence survives source-row deletion.
model ApplicationArtifact {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String                    @db.Uuid
  jobId         String?                   @db.Uuid
  applicationId String?                   @db.Uuid
  target        ApplicationArtifactTarget

  /// Logical Blob pathname. It is not globally unique because two stores may
  /// legitimately contain different physical objects at the same pathname.
  pathname            String
  url                 String?
  /// Lower-cased storage hostname plus decoded pathname. URL query/fragment
  /// aliases therefore converge while different stores remain distinct.
  storeHost           String?
  storageIdentity     String? @unique
  /// Serializes the upload-response-lost window before the store hostname is
  /// known. Cleared as soon as a canonical storage identity is recorded.
  provisionalIdentity String? @unique
  contentVersion      String?
  contentHash         String?

  state         ApplicationArtifactState @default(STAGED)
  deleteAfter   DateTime?
  retryCount    Int                      @default(0)
  nextAttemptAt DateTime?

  claimId             String?   @db.Uuid
  claimLeaseExpiresAt DateTime?
  lastError           String?

  stagedAt          DateTime  @default(now())
  referencedAt      DateTime?
  deleteRequestedAt DateTime?
  deletedAt         DateTime?
  inventorySeenAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([state, nextAttemptAt])
  @@index([state, deleteAfter])
  @@index([userId, jobId])
  @@index([applicationId])
  @@index([pathname])
  @@index([url])
}

/// Singleton checkpoint for bounded, resumable Blob inventory. The claim pair
/// fences concurrent cron invocations; cursor advances only under that lease.
model ApplicationArtifactInventoryCheckpoint {
  key                 String    @id
  cursor              String?
  claimId             String?   @db.Uuid
  claimLeaseExpiresAt DateTime?
  scanStartedAt       DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Immutable application-history ledger. Application code only creates rows; it
/// never updates or deletes them. Job.status is a read-optimized projection
/// updated in the same serializable transaction as STATUS_CHANGED events.
model ApplicationEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String?      @db.Uuid
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applicationId String?      @db.Uuid
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  /// Immutable display/cooldown identity retained after the source Job is
  /// hard-deleted. New writers always populate both fields.
  companySnapshot String?
  titleSnapshot   String?

  type           ApplicationEventType
  source         ApplicationEventSource @default(USER)
  fromStatus     JobStatus?
  toStatus       JobStatus?
  note           String?
  metadata       Json?
  idempotencyKey String?
  occurredAt     DateTime               @default(now())
  createdAt      DateTime               @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, occurredAt])
  @@index([userId, jobId, occurredAt])
  @@index([applicationId, occurredAt])
  @@index([userId, type, occurredAt])
}

/// Content-addressed evidence. `id` and `contentHash` are deterministic
/// SHA-256 derivatives generated from canonical JSON; identical evidence
/// within one tenant and kind is reused instead of copied.
/// Content-addressed evidence backing CV/CL claims.
///
/// Both foreign keys are SetNull rather than Cascade because one row is reused
/// across Applications whose evidence text matches — the id is derived from
/// (userId, kind, contentHash), not from the Job. `jobDeleteService` therefore
/// removes only rows with no surviving ClaimEvidence or STAR-story provenance
/// reference; a shared row outlives the Job it happens to point at, and its
/// `jobId` becomes null.
model EvidenceSnapshot {
  id            String       @id
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?      @db.Uuid
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  jobId         String?      @db.Uuid
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  kind        EvidenceKind
  contentHash String
  payload     Json
  sourceLabel String?
  createdAt   DateTime     @default(now())

  claims ClaimEvidence[]

  @@unique([userId, contentHash, kind])
  @@index([userId, createdAt])
  @@index([applicationId, kind])
  @@index([jobId, kind])
}

/// Claim-to-evidence edge used by CV/CL review. Claims may reference multiple
/// snapshots; no unsupported claim is considered grounded merely because an
/// edge exists; caller must still show the referenced source to the user.
model ClaimEvidence {
  id                 String           @id
  userId             String           @db.Uuid
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId      String           @db.Uuid
  application        Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evidenceSnapshotId String
  evidenceSnapshot   EvidenceSnapshot @relation(fields: [evidenceSnapshotId], references: [id], onDelete: Restrict)

  claimKey     String
  claimText    String
  claimHash    String
  evidencePath String?
  createdAt    DateTime @default(now())

  @@unique([applicationId, claimHash, evidenceSnapshotId])
  @@index([userId, applicationId])
  @@index([evidenceSnapshotId])
}

// Legacy Career-workspace records are retained to avoid destructive data loss.
// No active UI or public API writes these tables. Remove them only through an
// explicit, separately approved retention migration.
model PromptRuleTemplate {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  version         Int
  locale          String  @default("en-AU")
  cvRules         Json
  coverRules      Json
  hardConstraints Json
  isActive        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, version])
  @@index([userId, isActive, updatedAt])
}

model AgentCredential {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash    String    @unique // SHA-256 hash; the raw jfagent_v1_ token is shown once
  name         String    @default("Joblit Runner")
  audience     String    @default("joblit-agent")
  version      Int       @default(1)
  capabilities String[]
  lastUsedAt   DateTime?
  expiresAt    DateTime
  revokedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([audience, version, revokedAt])
}

model OnboardingState {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stage       OnboardingStage @default(NEW_USER)
  checklist   Json?
  dismissedAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, stage, updatedAt])
}

// Persistent cache for the user-triggered Discover Videos pipeline. Replaces
// the previous in-memory Map, which was wiped on every serverless cold start
// and drained YouTube quota. The user-facing route reads this table and falls
// back to stale rows when the upstream API returns quotaExceeded.
model DiscoverVideoCache {
  key       String   @id // e.g. "videos:claude:week"
  payload   Json
  fetchedAt DateTime
  expiresAt DateTime

  @@index([expiresAt])
}

/// Provider-level health is global operational data, never user-specific.
model SourceHealth {
  source              String             @id
  status              SourceHealthStatus @default(UNKNOWN)
  consecutiveFailures Int                @default(0)
  lastCheckedAt       DateTime?
  lastReachableAt     DateTime?
  lastFailureAt       DateTime?
  reason              String?
  updatedAt           DateTime           @updatedAt

  @@index([status, updatedAt])
}

/// Registry entry for public company ATS boards. Contains board identifiers
/// only—never credentials. Disabled rows remain for audit and rediscovery.
model AtsBoardSource {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId           String    @unique
  provider           String
  boardToken         String
  company            String
  region             String?
  careersUrl         String?
  enabled            Boolean   @default(true)
  lastRediscoveredAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([provider, boardToken])
  @@index([enabled, provider])
  @@index([company, region])
}
