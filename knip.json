{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["lib/generated/**", "**/dist/**"],
  "ignoreDependencies": [
    "@neondatabase/serverless",
    "axe-core",
    "tailwindcss",
    "tw-animate-css"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "instrumentation.ts",
        "prisma.config.ts",
        "tools/**/*.mjs"
      ],
      "project": ["**/*.{ts,tsx}", "!chrome-extension/**"]
    },
    "chrome-extension": {
      "entry": [
        "src/background/service-worker.ts",
        "src/content/index.ts",
        "src/popup/main.tsx",
        "src/popup/index.html",
        "vite.config.ts",
        "vitest.config.ts",
        "test/setup.ts"
      ],
      "project": "src/**/*.{ts,tsx}"
    }
  }
}
