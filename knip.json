{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": {
    "type": true
  },
  "ignore": [
    "lib/shared/schemas/resumeProfile.ts"
  ],
  "ignoreDependencies": [
    "@neondatabase/serverless",
    "axe-core",
    "tailwindcss",
    "tw-animate-css"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "tools/**/*.mjs"
      ],
      "project": ["**/*.{ts,tsx}", "!chrome-extension/**"]
    },
    "chrome-extension": {
      "entry": [
        "src/background/service-worker.ts",
        "src/content/index.ts",
        "src/content/seek/seekInterceptMain.ts",
        "src/popup/main.tsx",
        "src/popup/index.html"
      ],
      "project": "src/**/*.{ts,tsx}"
    }
  }
}
