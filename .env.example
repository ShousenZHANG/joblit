# ────────────────────────────────────────────────────────────
#   Joblit — Environment Variable Template
#
#   Copy this file to `.env` and fill in real values.
#   Anything marked REQUIRED must be set for the app to boot.
#   Anything marked OPTIONAL only enables that feature.
#
#   NEVER commit `.env` to version control.
# ────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# REQUIRED. Postgres connection string. Neon serverless format:
#   postgres://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────
# REQUIRED. Generate via: openssl rand -base64 32
AUTH_SECRET=

# REQUIRED. Google OAuth credentials.
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REQUIRED. GitHub OAuth credentials.
# Create at: https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=

# ── Internal API Auth ───────────────────────────────────────
# REQUIRED. Shared secret used by the AU fetch worker for
# /api/fetch-runs/[id]/config and receipt-backed commit commands at
# /api/fetch-runs/[id]/commit. Generate via: openssl rand -hex 32
FETCH_RUN_SECRET=

# REQUIRED. Base64-encoded encryption key for the extension token
# storage. Generate via: openssl rand -base64 32
APP_ENC_KEY=

# OPTIONAL. Distributed abuse budget for Extension ingress. Configure either
# the complete Upstash pair or the complete Vercel KV compatibility pair.
# A half-configured pair is invalid and never mixed across providers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── LaTeX PDF Render Service ────────────────────────────────
# REQUIRED. External service that compiles .tex -> .pdf.
LATEX_RENDER_URL=
LATEX_RENDER_TOKEN=
# OPTIONAL. Keep false unless a trusted self-hosted renderer is intentionally
# HTTP-only. HTTPS is the default because the token is sent in a request header.
LATEX_RENDER_ALLOW_INSECURE_HTTP=false

# ── AI Provider (optional) ──────────────────────────────────
# OPTIONAL. Without these, AI tailoring falls back to the
# manual JSON import path.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Vercel Blob ─────────────────────────────────────────────
# Required for FINAL PDF persistence outside tests and for reconciliation.
# DRAFT Application edits do not upload artifacts and do not require it.
BLOB_READ_WRITE_TOKEN=

# ── Fetch Worker Dispatch (optional) ────────────────────────
# OPTIONAL. Required only if you trigger the JobSpy fetcher via
# GitHub Actions workflow_dispatch.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_WORKFLOW_FILE=jobspy-fetch.yml
GITHUB_REF=master

# OPTIONAL. Default-off server-side Application Batch execution.
# Only exact 1/true enables it.
ENABLE_BATCH_EXECUTE_AUTOGEN=

# OPTIONAL. Public URL of the deployed app (extension callback).
JOBLIT_WEB_URL=https://www.joblit.tech

# ── Public ATS Boards (optional) ────────────────────────────
# OPTIONAL. Credential-free company boards. Hosts are provider-pinned;
# boardToken is the public tenant slug, never an API key.
# Example:
# JOBLIT_ATS_BOARDS_JSON=[{"provider":"greenhouse","boardToken":"acme","company":"Acme"}]
JOBLIT_ATS_BOARDS_JSON=[]

# ── Discover (optional) ─────────────────────────────────────
# OPTIONAL. YouTube curated video pipeline.
YOUTUBE_API_KEY=

# OPTIONAL. Required for the daily Discover cache refresh on Vercel.
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
# Generate via: openssl rand -hex 32
CRON_SECRET=

# OPTIONAL. Additional bearer for manual/operator reconciliation calls.
# Vercel Cron still authenticates scheduled calls with CRON_SECRET; the route
# accepts either credential when both are configured.
ARTIFACT_RECONCILE_SECRET=

# Kill switch. Only exact `true` or `1` enables inventory/claim/delete.
# Keep empty/false through migration, writer deployment, and old-binary drain.
ARTIFACT_RECONCILE_ENABLED=

# OPTIONAL. Server-side Seek JD enrichment. The browser Extension remains the
# supported collection path; only exact 1/true/yes enables this fallback.
SEEK_FETCH_ENABLED=
# Honest outbound identifier used only when Seek enrichment is enabled.
SEEK_USER_AGENT=Joblit-Fetcher/1.0 (+https://www.joblit.tech)

# ── China Job Sources (optional) ────────────────────────────
# OPTIONAL.
RSSHUB_URL=
RSSHUB_JOB_ROUTES=
GITHUB_CN_JOB_REPOS=

# ── Observability (optional) ────────────────────────────────
# OPTIONAL. When @sentry/nextjs is installed, this DSN routes
# errorReporter output to Sentry.
SENTRY_DSN=
