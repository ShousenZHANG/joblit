# ────────────────────────────────────────────────────────────
#   Joblit — Environment Variable Template
#
#   Copy this file to `.env` and fill in real values.
#   Anything marked REQUIRED must be set for the app to boot.
#   Anything marked OPTIONAL only enables that feature.
#
#   NEVER commit `.env` to version control.
# ────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# REQUIRED. Pooled Postgres connection used by the serverless application:
#   postgres://user:pass@ep-xxxx-pooler.neon.tech/dbname?sslmode=require
DATABASE_URL=
# OPTIONAL explicit direct, non-pooling connection for migrations:
#   postgres://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require
# Vercel/Neon may inject DATABASE_URL_UNPOOLED instead. When DATABASE_URL is a
# standard *.neon.tech `-pooler` host, Joblit derives the matching direct host.
# Other pooled providers must configure one of the explicit unpooled variables.
DIRECT_URL=

# ── Auth ────────────────────────────────────────────────────
# REQUIRED. Generate via: openssl rand -base64 32
AUTH_SECRET=

# REQUIRED. Google OAuth credentials.
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REQUIRED. GitHub OAuth credentials.
# Create at: https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=

# ── Internal API Auth ───────────────────────────────────────
# REQUIRED. Shared secret used by the AU fetch worker for
# /api/fetch-runs/[id]/config and receipt-backed commit commands at
# /api/fetch-runs/[id]/commit. Generate via: openssl rand -hex 32
FETCH_RUN_SECRET=

# ── LaTeX PDF Render Service ────────────────────────────────
# REQUIRED. External service that compiles .tex -> .pdf.
LATEX_RENDER_URL=
LATEX_RENDER_TOKEN=
# OPTIONAL. Keep false unless a trusted self-hosted renderer is intentionally
# HTTP-only. HTTPS is the default because the token is sent in a request header.
LATEX_RENDER_ALLOW_INSECURE_HTTP=false

# ── Vercel Blob ─────────────────────────────────────────────
# Required for FINAL PDF persistence outside tests and for reconciliation.
# DRAFT Application edits do not upload artifacts and do not require it.
BLOB_READ_WRITE_TOKEN=

# ── Fetch Worker Dispatch (optional) ────────────────────────
# OPTIONAL. Required only if you trigger the JobSpy fetcher via
# GitHub Actions workflow_dispatch.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_WORKFLOW_FILE=jobspy-fetch.yml
GITHUB_REF=master

# OPTIONAL. Public URL of the deployed app and AU fetch-worker callback.
JOBLIT_WEB_URL=https://www.joblit.tech

# ── Scheduled Jobs (optional) ───────────────────────────────
# OPTIONAL. Required for the daily artifact-reconciliation cron on Vercel.
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
# Generate via: openssl rand -hex 32
CRON_SECRET=

# OPTIONAL. Additional bearer for manual/operator reconciliation calls.
# Vercel Cron still authenticates scheduled calls with CRON_SECRET; the route
# accepts either credential when both are configured.
ARTIFACT_RECONCILE_SECRET=

# Kill switch. Only exact `true` or `1` enables inventory/claim/delete.
# Keep empty/false through migration, writer deployment, and old-binary drain.
ARTIFACT_RECONCILE_ENABLED=

# ── Batch Leases (optional) ─────────────────────────────────
# OPTIONAL. Milliseconds before a claimed Application Batch task is treated as
# stale and may be reclaimed. Unset uses the built-in default.
APPLICATION_BATCH_TASK_STALE_MS=

# ── Observability (optional) ────────────────────────────────
# OPTIONAL. When @sentry/nextjs is installed, this DSN routes
# errorReporter output to Sentry.
SENTRY_DSN=
