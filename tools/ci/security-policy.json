{
  "requiredGitignoreRules": [
    ".env*",
    "!.env.example",
    "*.pem",
    "*.key",
    "*.zip",
    "*.sig",
    "*hermes-receipt*.json",
    "/.tmp/",
    "/.tmp/hermes-*/"
  ],
  "serverOutboundFetch": {
