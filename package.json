{
  "name": "joblit",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end job-search workstation: fetch roles, triage, AI-tailor resumes and cover letters per JD, auto-fill ATS forms via a self-learning Chrome extension, and export bilingual LaTeX PDFs.",
  "homepage": "https://www.joblit.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShousenZHANG/jobflow-web.git"
  },
  "bugs": {
    "url": "https://github.com/ShousenZHANG/jobflow-web/issues"
  },
  "license": "Apache-2.0",
  "author": "Eddy Zhang <eddy.zhang24@gmail.com>",
  "keywords": [
    "job-search",
    "resume-builder",
    "ats",
    "chrome-extension",
    "ai-tailoring",
    "latex",
    "next.js",
    "prisma"
  ],
  "engines": {
    "node": ">=20.10",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deadcode": "knip --include files,dependencies",
    "deps:policy": "node tools/ci/check-dependency-policy.mjs",
    "deps:audit": "npm audit --omit=dev --audit-level=high",
    "readme:metrics": "node tools/readme/update-metrics-badges.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
