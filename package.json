    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "axe-core": "^4.11.4",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^27.4.0",
    "knip": "^5.88.1",
    "prisma": "^7.8.0",
