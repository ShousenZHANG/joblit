# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# oh-my-claudecode state
.omc/
/.superpowers/

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/chrome-extension/coverage/
/.pytest_cache/
/.ruff_cache/
/.mypy_cache/
/.coverage
/htmlcov/
**/__pycache__/
*.py[cod]

# next.js
/.next/
/out/

# production
/build
/chrome-extension/dist/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*~

# editor and IDE state
/.idea/
/.vscode/
*.suo
*.user

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
/logs/
/tmp/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# superpowers plans (generated)
docs/superpowers/plans/

# superpowers specs and visual companions (local design artifacts)
docs/superpowers/specs/
docs/superpowers/*.html

# agent/skills (npx skills add; local, do not commit)
.agent/
.agents/
.tabnine/
skills-lock.json

# Claude Code local config and worktrees
.claude/

# Everything Claude Code plugin (local tooling)
everything-claude-code/
install.cmd

# Generated reports and codemaps
.reports/
docs/CODEMAPS/
docs/refactor-report.md

# typescript
*.tsbuildinfo
next-env.d.ts

# ensure server code is tracked even with global ignores
!lib/
!lib/server/
!lib/server/**/*.ts

# Prisma client is generated by the postinstall script.
/lib/generated/prisma/

# Design reference docs (getdesign artifacts)
docs/design-references/
DESIGN.md
design-system/

# Packaged extension build artifacts
*.zip

# Generated Hermes profile packages, secrets, and local receipts
/.tmp/
/.tmp/hermes-*/
*.sig
*.key
*hermes-receipt*.json

# Packaged/unpacked extension artifacts (built from chrome-extension/dist)
chrome-extension/joblit-extension-*.zip
chrome-extension/joblit-extension-*/
